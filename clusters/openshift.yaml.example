# Copy to openshift.yaml. Configuration is committed; credentials and .work/ are not.
name: openshift
domain: openshift.example.com
zone_id: REPLACE_WITH_CLOUDFLARE_ZONE_ID
distribution: openshift
release: 4.18.1  # example only: pin the Red Hat version you intend to install
region: nbg1
network_zone: eu-central
masters: 3
workers: 3
master_type: cpx41
worker_type: cpx41
ignition_type: cpx21
credentials_file: .secrets/openshift.env
ssh_private_key: .secrets/openshift_id_rsa  # Also provide openshift_id_rsa.pub.
duration: 8
autodestroy: false
network:
  machine: 10.10.0.0/16
  nodes: 10.10.1.0/24
  load_balancer: 10.10.2.0/24
  pods: 10.128.0.0/14
  services: 172.30.0.0/16
  host_prefix: 23

pull_secret_file: .secrets/pull-secret.json
