{
  "uid": "obs-traces-tempo",
  "title": "Traces (Tempo)",
  "tags": ["observability", "traces", "tempo"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Recent traces (TraceQL)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Lists recent traces. Set the Service variable to filter, or click a Trace ID to open the trace view. Traces arrive via OTLP to the otel-collector.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \".*$service.*\" }",
          "tableType": "traces",
          "limit": 50
        }
      ]
    },
    {
      "id": 2,
      "type": "nodeGraph",
      "title": "Service graph (needs Tempo metrics-generator; empty otherwise)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "serviceMap"
        }
      ]
    }
  ]
}
