# Copy to .env and fill in your own values. .env is gitignored.
# Used by deploy-okd.sh / destroy-okd.sh and the Makefile targets they call.

# Hetzner Cloud API token (Project > Security > API Tokens, Read & Write)
HCLOUD_TOKEN=

# Cloudflare API token (Zone:DNS:Edit on the zone for TF_VAR_dns_zone_id)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMAIL=
TF_VAR_cloudflare_api_token=

# Cluster identity
TF_VAR_dns_domain=okd4.example.com
TF_VAR_dns_zone_id=

# Topology (overwritten by deploy-okd.sh based on your answers / --flags)
TF_VAR_replicas_master=3
TF_VAR_replicas_worker=3
TF_VAR_location=nbg1
TF_VAR_network_zone=eu-central
TF_VAR_server_type_master=cpx41
TF_VAR_server_type_worker=cpx41
TF_VAR_server_type_bootstrap=cpx41
TF_VAR_server_type_ignition=cpx21

# CoreOS snapshot build (overwritten by deploy-okd.sh)
PACKER_LOCATION=nbg1
PACKER_SERVER_TYPE=cx33
TF_VAR_fcos_release=

# Release / deployment type (overwritten by deploy-okd.sh)
OPENSHIFT_RELEASE=
DEPLOYMENT_TYPE=okd
